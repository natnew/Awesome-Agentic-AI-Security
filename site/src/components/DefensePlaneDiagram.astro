---
// Defense Plane: 4 concentric arcs for Observe / Interpret / Constrain / Audit
---
<svg class="aas-svg" viewBox="0 0 520 360" role="img" aria-label="AI Defense Plane">
  <g transform="translate(260 180)">
    <circle r="40" class="node-accent pulse"/>
    <text text-anchor="middle" y="4" font-size="12" fill="var(--aas-fg)">CORE</text>
    <text text-anchor="middle" y="20" font-size="10">agent runtime</text>

    <circle r="80" class="edge" fill="none"/>
    <circle r="120" class="edge" fill="none"/>
    <circle r="160" class="edge" fill="none"/>

    <!-- ring labels -->
    <text x="0" y="-72" text-anchor="middle" font-size="11" fill="var(--aas-accent)">OBSERVE</text>
    <text x="0" y="-112" text-anchor="middle" font-size="11" fill="var(--aas-accent)">INTERPRET</text>
    <text x="0" y="-152" text-anchor="middle" font-size="11" fill="var(--aas-accent)">CONSTRAIN</text>

    <!-- floating chips -->
    <g font-size="10" fill="var(--aas-muted)">
      <text x="-150" y="60">tool calls</text>
      <text x="120" y="60">memory writes</text>
      <text x="-150" y="-40">prompts</text>
      <text x="120" y="-40">credentials</text>
      <text x="-30" y="170">audit · evidence · review</text>
    </g>
  </g>
</svg>
