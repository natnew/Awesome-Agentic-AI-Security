---
// Animated execution-system diagram for the hero.
// Mirrors the README mermaid: prompt/context/rules -> reasoning -> tools -> risk basin.
---
<svg class="aas-svg" viewBox="0 0 720 360" role="img" aria-label="Agentic execution diagram">
  <defs>
    <marker id="aas-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="currentColor" style="color: var(--aas-accent)"/>
    </marker>
  </defs>

  <!-- Inputs -->
  <g>
    <rect class="node" x="20" y="40" width="140" height="46" rx="6"/>
    <text x="90" y="68" text-anchor="middle" font-size="12">USER PROMPT</text>

    <rect class="node" x="20" y="160" width="140" height="46" rx="6"/>
    <text x="90" y="188" text-anchor="middle" font-size="12">RETRIEVED CONTEXT</text>

    <rect class="node" x="20" y="280" width="140" height="46" rx="6"/>
    <text x="90" y="308" text-anchor="middle" font-size="12">SYSTEM RULES</text>
  </g>

  <!-- Reasoning core -->
  <g>
    <rect class="node-accent pulse" x="280" y="140" width="160" height="86" rx="10"/>
    <text x="360" y="178" text-anchor="middle" font-size="13" fill="var(--aas-fg)">AGENTIC REASONING</text>
    <text x="360" y="200" text-anchor="middle" font-size="11">goals emerge at runtime</text>
  </g>

  <!-- Outputs -->
  <g>
    <rect class="node" x="540" y="40" width="160" height="46" rx="6"/>
    <text x="620" y="68" text-anchor="middle" font-size="12">INTERNAL KNOWLEDGE</text>

    <rect class="node" x="540" y="160" width="160" height="46" rx="6"/>
    <text x="620" y="188" text-anchor="middle" font-size="12">EXTERNAL APIS</text>

    <rect class="node" x="540" y="280" width="160" height="46" rx="6"/>
    <text x="620" y="308" text-anchor="middle" font-size="12">OPERATIONAL TOOLS</text>
  </g>

  <!-- Edges in -->
  <path class="edge flow" d="M160 63 C 220 63, 240 165, 280 175" marker-end="url(#aas-arrow)"/>
  <path class="edge flow" d="M160 183 C 220 183, 240 183, 280 183"  marker-end="url(#aas-arrow)" style="animation-delay:-2s"/>
  <path class="edge flow" d="M160 303 C 220 303, 240 200, 280 195"  marker-end="url(#aas-arrow)" style="animation-delay:-4s"/>

  <!-- Edges out -->
  <path class="edge-accent flow" d="M440 175 C 480 80, 510 65, 540 63" marker-end="url(#aas-arrow)"/>
  <path class="edge-accent flow" d="M440 183 C 480 183, 510 183, 540 183" marker-end="url(#aas-arrow)" style="animation-delay:-2s"/>
  <path class="edge-accent flow" d="M440 195 C 480 280, 510 305, 540 303" marker-end="url(#aas-arrow)" style="animation-delay:-4s"/>

  <!-- Annotation -->
  <g opacity="0.7">
    <text x="360" y="40" text-anchor="middle" font-size="10" fill="var(--aas-muted)">PERMITTED STEP · LOCAL CHECK</text>
    <text x="360" y="350" text-anchor="middle" font-size="10" fill="var(--aas-muted)">COMPOSED OUTCOME MAY EXCEED APPROVED SCOPE</text>
  </g>
</svg>
